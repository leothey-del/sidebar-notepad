{
  "name": "vscodesidebar-notes",
  "displayName": "Sidebar Notepad",
  "description": "Keep your thoughts organized with persistent notes that sync across projects",
  "version": "0.0.2",
  "publisher": "leoOrtega",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leothey-del/sidebar-notepad.git"
  },
  "bugs": {
    "url": "https://github.com/leothey-del/sidebar-notepad/issues"
  },
  "homepage": "https://github.com/leothey-del/sidebar-notepad#readme",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:notesView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": []
    },
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "notesView",
          "name": "Notes"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.5"
  }
}