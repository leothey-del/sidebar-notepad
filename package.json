{
  "name": "vscodesidebar-notes",
  "displayName": "Sidebar Notepad",
  "description": "Keep your thoughts organized with persistent notes that sync across projects",
  "version": "0.4.6",
  "publisher": "leoOrtega",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/leothey-del/sidebar-notepad.git"
  },
  "bugs": {
    "url": "https://github.com/leothey-del/sidebar-notepad/issues"
  },
  "homepage": "https://github.com/leothey-del/sidebar-notepad#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "keywords": [
    "notes",
    "notepad",
    "sidebar",
    "todo",
    "markdown",
    "scratchpad"
  ],
  "activationEvents": [
    "onView:notesView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sidebarNotepad",
          "title": "Notes",
          "icon": "media/notes-view.svg"
        }
      ]
    },
    "views": {
      "sidebarNotepad": [
        {
          "type": "webview",
          "id": "notesView",
          "name": "Notes",
          "icon": "media/notes-view.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "quickNotes.newNote",
        "title": "New Note",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.nextNote",
        "title": "Next Note",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.prevNote",
        "title": "Previous Note",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.searchNotes",
        "title": "Search Notes",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.addSelection",
        "title": "Add Selection to Note",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.newNoteFromSelection",
        "title": "New Note from Selection",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.exportNotes",
        "title": "Export All Global Notes",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.importNotes",
        "title": "Import Notes",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.activateProLicense",
        "title": "Activate Pro License",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.deactivateProLicense",
        "title": "Deactivate Pro License",
        "category": "Quick Notes"
      },
      {
        "command": "quickNotes.newNoteFromTerminal",
        "title": "New Note from Terminal Command",
        "category": "Quick Notes"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "quickNotes.addSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@99"
        },
        {
          "command": "quickNotes.newNoteFromSelection",
          "when": "editorHasSelection",
          "group": "9_cutcopypaste@100"
        }
      ],
      "terminal/context": [
        {
          "command": "quickNotes.newNoteFromTerminal",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "quickNotes.addSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "quickNotes.newNoteFromSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "quickNotes.newNoteFromTerminal"
        }
      ]
    },
    "keybindings": [
      {
        "command": "quickNotes.newNote",
        "key": "alt+shift+n",
        "mac": "alt+shift+n"
      },
      {
        "command": "quickNotes.searchNotes",
        "key": "alt+shift+s",
        "mac": "alt+shift+s"
      },
      {
        "command": "quickNotes.nextNote",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+."
      },
      {
        "command": "quickNotes.prevNote",
        "key": "ctrl+alt+,",
        "mac": "cmd+alt+,"
      },
      {
        "command": "quickNotes.addSelection",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Sidebar Quick Notes",
      "properties": {
        "sidebarQuickNotes.autoSaveDelay": {
          "type": "number",
          "default": 400,
          "minimum": 100,
          "maximum": 5000,
          "description": "How long to wait after you stop typing before saving, in milliseconds."
        },
        "sidebarQuickNotes.fontSize": {
          "type": "number",
          "default": 13,
          "minimum": 1,
          "maximum": 24,
          "description": "Font size of the note text."
        },
        "sidebarQuickNotes.newNoteTitle": {
          "type": "string",
          "enum": [
            "untitled",
            "date"
          ],
          "enumDescriptions": [
            "New notes start as Untitled.",
            "New notes start with today's date as the title."
          ],
          "default": "untitled",
          "description": "Title given to a new note."
        },
        "sidebarQuickNotes.trashRetentionDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 365,
          "description": "How many days deleted notes stay in Trash before they are removed for good."
        },
        "sidebarQuickNotes.ai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI actions for notes. Note text is sent to the selected VS Code language model when you run an action."
        },
        "sidebarQuickNotes.ai.modelFamily": {
          "type": "string",
          "default": "",
          "description": "Preferred Copilot model family for AI actions. Leave empty to use an available model."
        },
        "sidebarQuickNotes.ai.polar.organizationId": {
          "type": "string",
          "default": "78e00919-a1d4-4deb-a77f-a82227d00581",
          "description": "Polar organization UUID used to verify Pro license keys."
        },
        "sidebarQuickNotes.ai.polar.benefitId": {
          "type": "string",
          "default": "f9488571-6980-492f-b82e-be64240a7489",
          "description": "Polar benefit UUID for the Pro license."
        },
        "sidebarQuickNotes.ai.polar.environment": {
          "type": "string",
          "enum": [
            "production",
            "sandbox"
          ],
          "default": "sandbox",
          "description": "Polar API environment used to verify license keys. Select sandbox for test keys."
        },
        "sidebarQuickNotes.ai.polar.checkoutUrl": {
          "type": "string",
          "default": "https://sandbox-api.polar.sh/v1/checkout-links/polar_cl_zHcTQ91zgbD1rSm9RGiu9N2MDdFI0a8IyHxdi0izkJp/redirect",
          "description": "Polar checkout link opened when users upgrade to Pro."
        },
        "sidebarQuickNotes.syncWithSettingsSync": {
          "type": "boolean",
          "default": false,
          "description": "Include your global notes in VS Code Settings Sync so they follow you between computers. Requires Settings Sync to be turned on, and a newer edit on one computer can replace the other."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build:webview": "esbuild webview/highlight.js --bundle --minify --platform=browser --outfile=media/highlight.js",
    "compile": "npm run build:webview && tsc -p ./",
    "watch": "npm run build:webview && tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "marked": "^16.0.0"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/leoort"
  }
}
